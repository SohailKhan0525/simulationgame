config_version=5

[application]
config/name="Qofeno Drive"
run/main_scene="res://scenes/main.tscn"
run/max_fps=60
config/features=PackedStringArray("4.5", "Mobile")
config/icon="res://assets/icon.svg"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0

[rendering]
renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
rendering_device/driver.android="vulkan"
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true
textures/vram_compression/import_s3tc_bptc=true
anti_aliasing/quality/msaa_3d=1
; Godot 4.5.1 forces 256 for UPDATE_ALWAYS probes (128 triggers a runtime resize).
reflections/reflection_atlas/reflection_size=256
reflections/reflection_atlas/reflection_size.mobile=256
reflections/reflection_atlas/reflection_count=1
reflections/reflection_atlas/reflection_count.mobile=1
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/size.mobile=2048
environment/glow/upscale_mode=0

[physics]
common/physics_ticks_per_second=60
3d/physics_engine="GodotPhysics3D"

[audio]
general/text_to_speech=true

[editor_plugins]
enabled=PackedStringArray("res://addons/qofeno_updater/plugin.cfg")
